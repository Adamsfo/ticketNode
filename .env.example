PORT=9000
BASE=http://localhost:9000

# URL pública do frontend (links WhatsApp/e-mail: /reserva/{token})
# Produção (NODE_ENV=production):
SITE_URL=https://jangoingressos.com.br
# Desenvolvimento (local Expo web — porta do projeto):
SITE_URL_DEV=http://localhost:8081
# Opcionais: FRONTEND_URL, FRONTEND_URL_DEV, EXPO_PUBLIC_SITE_URL, BASE_URL

# MySQL (app)
DB_DIALECT=mysql
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=ticketJango
DB_TIMEZONE=+00:00

# Firebird / Jango PDV
JANGO_FB_HOST=
JANGO_FB_PORT=3050
JANGO_FB_DATABASE=
JANGO_FB_USER=
JANGO_FB_PASSWORD=
JANGO_API_BASE=
JANGO_API_FOTOS_BASE=

# Auth / crypto
JWT_SECRET=
ENCRYPTION_KEY=

# Mercado Pago
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_TANZ_ACCESS_TOKEN=

# SuperTEF / Stone
SUPERTEF_BEARER_TOKEN=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Jango Ingressos <no-reply@jangoingressos.com.br>

# ChatPro
CHATPRO_AUTH_TOKEN=
CHATPRO_API_URL=

# Z-API
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=

# Hospedin (Channel Manager / PMS) — módulo isolado (staging)
# Docs: https://pms.hospedin.com/api-docs/v1/swagger.yaml
HOSPEDIN_API_URL=https://pms-api.hospedin.com
HOSPEDIN_EMAIL=
HOSPEDIN_PASSWORD=
HOSPEDIN_TOKEN=
# Slug ou ID (ex.: pousada-jango | 69532). my_account retorna 403 nesta conta.
HOSPEDIN_ACCOUNT_ID=
HOSPEDIN_TIMEOUT_MS=30000
HOSPEDIN_PAGE_SIZE=100
HOSPEDIN_MAX_PAGES=500
HOSPEDIN_MAX_RETRIES=2
HOSPEDIN_RETRY_DELAY_MS=500
HOSPEDIN_DEBUG=false

# Logs da API (terminal limpo por padrão)
# ERROR | WARN | INFO | DEBUG
LOG_LEVEL=INFO
LOG_SQL=false
LOG_HTTP=false
LOG_PAYLOAD=false
# Usuario.id usado em CREATE de reservas sync (obrigatório em produção)
# HOSPEDIN_SYNC_USER_ID=
# (legado) não usado — incremental filtra só check_in >= hoje
# HOSPEDIN_HISTORICAL_SYNC_DAYS=30

# Scheduler automático (Fase 2) — seed inicial; depois prevalece o banco
# HOSPEDIN_SYNC_ENABLED=true
# HOSPEDIN_SYNC_INTERVAL_MINUTES=5
# HOSPEDIN_SYNC_MODE=incremental
# HOSPEDIN_SYNC_LIMIT=50
# HOSPEDIN_SYNC_PRIORITY=100
# HOSPEDIN_SYNC_MAX_RETRIES=2
# HOSPEDIN_SYNC_BACKOFF_BASE_SECONDS=30
# HOSPEDIN_SYNC_WEBHOOK_ENABLED=false
